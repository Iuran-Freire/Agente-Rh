# Copie este arquivo para .env e coloque sua chave da API da Anthropic
# (crie uma em https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Envio de e-mail pelo Gmail (Etapa 5)
# GMAIL_SENHA_APP é uma "senha de app" de 16 letras, não a sua senha normal.
# Crie em https://myaccount.google.com/apppasswords (exige verificação em 2 etapas).
GMAIL_USUARIO=
GMAIL_SENHA_APP=
# Opcional: para onde mandar. Se ficar vazio, manda para o próprio GMAIL_USUARIO.
EMAIL_DESTINO=
